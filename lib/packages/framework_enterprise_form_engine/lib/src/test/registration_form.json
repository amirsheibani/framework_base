{
  "title": "فرم ثبت‌نام کاربر جدید",
  "sections": [
    {
      "id": "personal_info",
      "title": "اطلاعات شخصی",
      "fields": [
        {
          "name": "fullName",
          "label": "نام و نام خانوادگی",
          "type": "text",
          "placeholder": "مثلاً علی رضایی",
          "validationRules": [
            { "type": "required" },
            { "type": "minLength", "value": 3 }
          ]
        },
        {
          "name": "email",
          "label": "ایمیل",
          "type": "email",
          "validationRules": [
            { "type": "required" },
            { "type": "email" }
          ]
        },
        {
          "name": "phone",
          "label": "شماره تماس",
          "type": "phone",
          "validationRules": [
            { "type": "pattern", "value": "^09[0-9]{9}$" }
          ]
        },
        {
          "name": "birthDate",
          "label": "تاریخ تولد",
          "type": "date"
        },
        {
          "name": "preferredTime",
          "label": "ساعت تماس دلخواه",
          "type": "time"
        }
      ]
    },
    {
      "id": "account_info",
      "title": "اطلاعات حساب کاربری",
      "fields": [
        {
          "name": "username",
          "label": "نام کاربری",
          "type": "text",
          "validationRules": [
            { "type": "required" },
            { "type": "minLength", "value": 4 }
          ]
        },
        {
          "name": "password",
          "label": "رمز عبور",
          "type": "text",
          "validationRules": [
            { "type": "required" },
            { "type": "minLength", "value": 6 }
          ]
        },
        {
          "name": "confirmPassword",
          "label": "تأیید رمز عبور",
          "type": "text",
          "validationRules": [
            { "type": "required" },
            {
              "type": "pattern",
              "value": "{{password}}",
              "errorMessage": "تأیید رمز باید مشابه رمز عبور باشد"
            }
          ]
        }
      ]
    },
    {
      "id": "preferences",
      "title": "ترجیحات کاربر",
      "fields": [
        {
          "name": "contactMethod",
          "label": "روش تماس دلخواه",
          "type": "radio",
          "options": ["ایمیل", "تلفن", "پیامک"],
          "validationRules": [{ "type": "required" }]
        },
        {
          "name": "timeRange",
          "label": "بازه زمانی تماس",
          "type": "dropdown",
          "options": ["صبح", "ظهر", "عصر"],
          "visibleWhen": [
            {
              "field": "contactMethod",
              "operator": "equals",
              "value": "تلفن"
            }
          ]
        },
        {
          "name": "acceptTerms",
          "label": "شرایط استفاده را می‌پذیرم",
          "type": "checkbox",
          "validationRules": [{ "type": "required" }]
        }
      ]
    }
  ]
}
